<!-- Squat silhouette — white figure, 64×64dp viewport -->
<!-- Use as exercise thumbnail in workout cards -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="64dp"
    android:height="64dp"
    android:viewportWidth="64"
    android:viewportHeight="64">

    <!-- Head -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M32,7 a5,5 0 1,1 0.001,0 Z" />

    <!-- Torso — leaning forward in parallel squat -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M28,14 Q27,18 26,22 Q28,21 32,21 Q36,21 38,22 Q37,18 36,14 Z" />

    <!-- Arms extended forward -->
    <path
        android:fillColor="#FFFFFF"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:pathData="M27,16 Q22,19 17,22" />
    <path
        android:fillColor="#FFFFFF"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:pathData="M37,16 Q42,19 47,22" />

    <!-- Upper legs (thighs) — parallel squat, knees at 90° -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M26,21 Q24,28 22,34 L26,35 Q28,29 30,22 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M38,21 Q40,28 42,34 L38,35 Q36,29 34,22 Z" />

    <!-- Lower legs (shins) — going back down to feet -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M22,34 Q23,42 24,48 L28,48 Q28,42 26,35 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M42,34 Q41,42 40,48 L36,48 Q36,42 38,35 Z" />

    <!-- Feet -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M20,48 Q22,47 28,48 L28,51 Q22,51 20,51 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M36,48 Q42,47 44,48 L44,51 Q36,51 36,51 Z" />

</vector>
