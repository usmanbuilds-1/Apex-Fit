<!-- Hero image placeholder — used when no photo is loaded yet.
     Dark gradient matching the app background with a subtle teal cast.
     Replace this by calling AsyncImage(model = user.heroImageUrl) via Coil,
     or by bundling hero_workout_strength.jpg / hero_workout_cardio.jpg. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base: app background color -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#080F0E" />
        </shape>
    </item>

    <!-- Top: slightly lighter teal gradient toward centre -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="80%"
                android:centerX="0.75"
                android:centerY="0.35"
                android:startColor="#142421"
                android:endColor="#080F0E" />
        </shape>
    </item>

</layer-list>
