<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude only DataStore proto files; Room DB backed up by Android Auto Backup -->
        <exclude domain="sharedpref" path="androidx.datastore" />
    </cloud-backup>
    <device-transfer>
        <!-- No exclusions — full transfer on new device setup -->
    </device-transfer>
</data-extraction-rules>
